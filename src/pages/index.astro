---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import HeroCentre from '../components/HeroCentre.astro';
import Proof from '../components/Proof.astro';
import Problem from '../components/Problem.astro';
import Benefits from '../components/Benefits.astro';
import Plan from '../components/Plan.astro';
import Guide from '../components/Guide.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Knead — Logiciel de gestion pour pâtissiers : coûts, marges, commandes"
  description="Le logiciel de gestion conçu par un chef pâtissier : scan de factures, coût de revient, marges en temps réel, commandes et planning. Essai gratuit 7 jours, sans CB."
>
  <Header />
  <main id="contenu">
    <HeroCentre />
    <Proof />
    <Problem />
    <Benefits />
    <Plan />
    <Guide />
    <Testimonials />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
