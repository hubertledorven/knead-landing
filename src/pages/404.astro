---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page introuvable — Knead"
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>
  <main id="contenu" class="notfound">
    <a href="/" class="brand">Knead<span>.</span></a>
    <h1>Cette page n'existe pas.</h1>
    <p>Le lien est peut-être ancien, ou l'adresse contient une erreur.</p>
    <div class="actions">
      <a href="/" class="btn">Retour à l'accueil</a>
      <a href="/blog/" class="link">Lire le blog</a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px;
    min-height: 100vh; min-height: 100dvh; padding: 48px var(--gutter); background: var(--paper); text-align: center;
  }
  .brand { margin-bottom: 20px; font-family: var(--logo); font-size: 1.875rem; font-weight: 600; color: var(--navy); text-decoration: none; }
  .brand span { color: var(--gold-ink); }
  h1 { font-size: clamp(2rem, 3.4vw, 2.75rem); }
  p { color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 24px; margin-top: 12px; }
  .link { font-weight: 600; color: var(--navy); text-underline-offset: 4px; text-decoration-color: var(--gold-ink); }
</style>
