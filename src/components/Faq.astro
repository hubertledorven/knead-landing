---
import { faq } from '../data/faq';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.reponse },
  })),
};
---
<section class="faq" id="faq">
  <div class="wrap">
    <div class="head">
      <h2 data-reveal>Vos questions, avant de vous lancer</h2>
    </div>
    <div class="list" data-reveal>
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.question}</summary>
          <p>{f.reponse}</p>
        </details>
      ))}
    </div>
    <p class="contact" data-reveal>Une autre question&nbsp;? <a href="mailto:contact@kneadmanager.com">Écrivez-nous</a></p>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq { padding-block: var(--space-section); background: var(--paper); }
  .head { margin-bottom: var(--space-heading); text-align: center; }
  .contact { margin-top: var(--space-after); text-align: center; color: var(--ink-2); }
  .contact a { font-weight: 600; color: var(--navy); text-underline-offset: 4px; text-decoration-color: var(--gold-ink); }
  .list { max-width: 800px; margin-inline: auto; border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary {
    display: flex; justify-content: space-between; align-items: baseline; gap: 20px;
    padding-block: 20px; font-weight: 600; color: var(--navy); cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; font-size: 1.5rem; font-weight: 400; line-height: 1; color: var(--gold-ink); }
  details[open] summary::after { content: '−'; }
  details p { max-width: 38em; padding-bottom: 24px; color: var(--ink-2); }
</style>
