---
const signup = 'https://app.kneadmanager.com/#signup';

const factures = [
  { nom: 'Beurre de tourage', prix: '9,85 €/kg', statut: '+7 %', hausse: true },
  { nom: 'Crème 35 %', prix: '4,35 €/L', statut: '+6 %', hausse: true },
  { nom: 'Chocolat noir 70 %', prix: '13,50 €/kg', statut: 'Inchangé', hausse: false },
  { nom: 'Praliné noisette', prix: '18,40 €/kg', statut: 'Créé', hausse: false },
];
const recettes = [
  { nom: 'Entremets', cout: '33,45 €', prix: '30,00 €', marge: '−3,45 €', perte: true },
  { nom: 'Flan 8 parts', cout: '12,40 €', prix: '32,00 €', marge: '+19,60 €' },
  { nom: 'Tarte citron', cout: '14,80 €', prix: '34,00 €', marge: '+19,20 €' },
  { nom: 'Saint-Honoré', cout: '38,50 €', prix: '78,00 €', marge: '+39,50 €' },
];
const semaine = [
  { jour: 'Mar', items: ['Pâte sucrée', 'Flan ×6', 'Choux'] },
  { jour: 'Mer', items: ['Biscuits', 'Crémeux', 'Glaçage'] },
  { jour: 'Jeu', items: ['Entremets ×2', 'Madeleines', 'Tartes ×4'] },
  { jour: 'Ven', items: ['Saint-Honoré', 'Flan ×8', 'Montage'] },
  { jour: 'Sam', items: ['Vitrine', 'Retraits', 'Livraison'] },
];
---
<section class="benefits" id="benefices">
  <div class="wrap">
    <h2>Ce que Knead change dans votre semaine</h2>

    <div class="bento">
      <article class="card span-5">
        <i class="dot" aria-hidden="true"></i>
        <div class="text">
          <h3>Photographiez la facture, vos prix se mettent à jour</h3>
          <p>L'IA lit les ingrédients et les prix, puis crée ou met à jour vos fiches. Vous n'avez plus rien à ressaisir.</p>
        </div>
        <div class="ui" aria-hidden="true">
          <div class="ui-head"><b>Facture fournisseur</b><span>4 lignes lues</span></div>
          <ul class="rows">
            {factures.map((f) => (
              <li><span>{f.nom}</span><span class="end"><b>{f.prix}</b><em class:list={{ up: f.hausse }}>{f.statut}</em></span></li>
            ))}
          </ul>
        </div>
      </article>

      <article class="card span-7">
        <i class="dot" aria-hidden="true"></i>
        <div class="text">
          <h3>Repérez ce qui vous fait perdre de l'argent</h3>
          <p>Le coût de chaque recette, temps de travail et pertes compris, avec la marge en face. Quand le beurre augmente, vos marges se recalculent.</p>
        </div>
        <div class="ui" aria-hidden="true">
          <div class="ui-head"><b>Marge par recette</b><span>Exemple</span></div>
          <div class="margins">
            <div class="m-row m-head"><span>Recette</span><span>Coût</span><span>Prix</span><span>Marge</span></div>
            {recettes.map((r) => (
              <div class:list={['m-row', { loss: r.perte }]}>
                <span>{r.nom}</span><span>{r.cout}</span><span>{r.prix}</span><b>{r.marge}</b>
              </div>
            ))}
          </div>
        </div>
      </article>

      <article class="card span-7">
        <i class="dot" aria-hidden="true"></i>
        <div class="text">
          <h3>Votre semaine de production, jour par jour</h3>
          <p>Chaque commande se place au bon jour&nbsp;: vous savez quoi préparer, et quand.</p>
        </div>
        <div class="ui" aria-hidden="true">
          <div class="week">
            {semaine.map((d) => (
              <div class="day">
                <b>{d.jour}</b>
                {d.items.map((i) => <span>{i}</span>)}
              </div>
            ))}
          </div>
        </div>
      </article>

      <article class="card span-5">
        <i class="dot" aria-hidden="true"></i>
        <div class="text">
          <h3>Prévenu avant la rupture</h3>
          <p>Plus jamais à court de praliné un samedi matin&nbsp;: Knead vous prévient à temps.</p>
        </div>
        <div class="ui" aria-hidden="true">
          <div class="ui-head"><b>Stocks</b><span>Exemple</span></div>
          <div class="stock">
            <div class="stock-line"><span>Praliné noisette</span><b class="low">1,2 kg</b></div>
            <div class="gauge"><i class="g-low"></i></div>
            <p class="stock-note">Sous votre seuil de 2 kg</p>
            <div class="stock-line"><span>Beurre de tourage</span><b>8 kg</b></div>
            <div class="gauge"><i class="g-ok"></i></div>
          </div>
        </div>
      </article>
    </div>

    <div class="after">
      <p><strong>Et aussi&nbsp;:</strong> seuil de rentabilité, devis et factures, suivi des pertes, hygiène et PMS, assistant intégré.</p>
      <a href={signup} class="btn">Essai gratuit 7 jours</a>
    </div>
  </div>
</section>

<style>
  .benefits { padding-block: var(--space-section); background: var(--paper); }
  h2 { max-width: 16em; margin-bottom: var(--space-heading); }
  .bento { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
  .span-5 { grid-column: span 5; }
  .span-7 { grid-column: span 7; }

  .card {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
    padding: 36px 36px 0; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    box-shadow: 0 10px 28px rgba(15, 31, 61, .06);
  }
  /* Point vert posé sur l'angle de la carte, en réponse au point rouge des douleurs. */
  .dot {
    position: absolute; top: -2px; left: -2px; width: 10px; height: 10px; background: var(--ok); border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(31, 122, 77, .22);
    animation: resolu 2.6s ease-in-out infinite;
  }
  .card:nth-child(2) .dot { animation-delay: -.65s; }
  .card:nth-child(3) .dot { animation-delay: -1.3s; }
  .card:nth-child(4) .dot { animation-delay: -1.95s; }
  @keyframes resolu {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 3px rgba(31, 122, 77, .22); }
    50% { opacity: .55; box-shadow: 0 0 0 6px rgba(31, 122, 77, .06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
  .text p { margin-top: 12px; color: var(--ink-2); }

  /* Fragments d'interface : données d'exemple, à aligner sur l'app réelle. */
  .ui {
    padding: 20px 22px; background: #fff; border: 1px solid var(--line); border-bottom: 0;
    border-radius: 10px 10px 0 0; font-size: .9375rem; line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }
  .ui-head { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .ui-head b { color: var(--navy); font-weight: 600; }
  .rows { list-style: none; }
  .rows li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; padding: 10px 0; border-bottom: 1px solid var(--line-soft); }
  .rows li:last-child { border-bottom: 0; }
  .rows b { font-weight: 600; color: var(--navy); white-space: nowrap; }
  .end { display: flex; align-items: baseline; gap: 12px; margin-left: auto; }
  .end em { font-style: normal; font-size: .875rem; color: var(--ink-2); min-width: 4.2em; text-align: right; }
  .end em.up { color: var(--loss); font-weight: 600; }
  .m-row { display: grid; grid-template-columns: minmax(0, 1fr) 3.75rem 3.75rem 4.25rem; gap: 6px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-soft); font-size: .875rem; }
  .m-row:last-child { border-bottom: 0; padding-bottom: 20px; }
  .m-row > :not(:first-child) { text-align: right; white-space: nowrap; }
  .m-row b { font-weight: 600; color: var(--navy); }
  .m-head { padding-bottom: 8px; font-size: .8125rem; color: var(--ink-2); }
  .loss, .loss b { color: var(--loss); font-weight: 600; }

  .week { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .day { display: flex; flex-direction: column; gap: 6px; padding-bottom: 12px; }
  .day b { padding-bottom: 8px; font-weight: 600; color: var(--navy); }
  .day span { padding: 7px 8px; background: var(--paper); border-left: 2px solid var(--navy); border-radius: 3px; font-size: .8125rem; }

  .stock { padding-top: 14px; }
  .stock-line { display: flex; justify-content: space-between; gap: 12px; }
  .stock-line b { font-weight: 600; color: var(--navy); }
  .stock-line b.low, .stock-note { color: var(--loss); }
  .stock-note { margin: 6px 0 18px; font-size: .875rem; font-weight: 600; }
  .gauge { height: 6px; margin-top: 8px; background: var(--track); border-radius: 3px; overflow: hidden; }
  .gauge i { display: block; height: 100%; }
  .g-low { width: 24%; background: var(--loss); }
  .g-ok { width: 80%; background: var(--ok); margin-bottom: 0; }
  .stock > .gauge:last-child { margin-bottom: 16px; }

  .after { display: flex; flex-direction: column; align-items: center; gap: 24px; margin-top: var(--space-after); text-align: center; }
  .after p { color: var(--ink-2); }
  .after strong { color: var(--navy); font-weight: 600; }

  /* Cinq jours dans une carte étroite : étiquettes resserrées pour ne pas couper les mots. */
  @media (min-width: 1001px) and (max-width: 1100px) {
    .day span { padding-inline: 5px; font-size: .75rem; }
  }
  @media (max-width: 1000px) {
    .span-5, .span-7 { grid-column: span 12; }
  }
  @media (max-width: 640px) {
    .card { padding: 28px 20px 0; }
    .m-row { grid-template-columns: minmax(0, 1fr) 3.75rem 4.25rem; }
    .m-row > :nth-child(2) { display: none; }
    .ui { padding: 16px; }
    .week { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .day:nth-child(n + 4) { display: none; }
    .after .btn { width: 100%; }
  }
  /* Deux jours seulement sur les petits téléphones : les noms de préparation tiennent dans leur étiquette. */
  @media (max-width: 28em) {
    .week { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .day:nth-child(n + 3) { display: none; }
  }
</style>
