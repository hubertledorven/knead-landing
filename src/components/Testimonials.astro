---
import { Image } from 'astro:assets';
import InstagramIcon from './InstagramIcon.astro';
import { temoignages } from '../data/temoignages';

const signup = 'https://app.kneadmanager.com/#signup';

interface Props {
  /** Affiche des emplacements explicites tant qu'aucun témoignage réel n'est disponible. */
  apercu?: boolean;
}
const { apercu = false } = Astro.props;
const emplacements = [
  'Avant Knead : comment la personne calculait ses coûts.',
  'Le résultat concret : une marge corrigée, un prix revu, du temps gagné. Un chiffre réel si possible.',
  'Une objection levée : la prise en main, le temps de mise en route.',
  'Ce qui a changé dans sa semaine.',
  'Une courte citation.',
];
// Le mur s'adapte au nombre de citations : pas de colonnes vides avec une ou deux citations.
const colonnes = Math.min(temoignages.length || emplacements.length, 3);
---
{(temoignages.length > 0 || apercu) && (
  <section class="testimonials">
    <div class="wrap">
      <h2>Ce qu'en disent celles et ceux qui l'utilisent</h2>
      <div class:list={['wall', `cols-${colonnes}`]}>
        {temoignages.length > 0
          ? temoignages.map((t) => (
              <figure class="item">
                <blockquote>{t.citation}</blockquote>
                <figcaption>
                  {t.photo && <Image src={t.photo} alt="" width={44} height={44} widths={[44, 88]} sizes="44px" format="webp" />}
                  <span>
                    {t.instagram && <InstagramIcon />}<strong>{t.nom}</strong>
                    {t.boutique && <><br />{t.boutique}{t.ville ? `, ${t.ville}` : ''}</>}
                  </span>
                </figcaption>
              </figure>
            ))
          : emplacements.map((texte) => (
              <figure class="item slot">
                <span class="tag">Témoignage à venir</span>
                <blockquote>{texte}</blockquote>
                <figcaption>
                  <span class="slot-photo" aria-hidden="true"></span>
                  <span><strong>Prénom Nom</strong><br />Boutique, ville</span>
                </figcaption>
              </figure>
            ))}
      </div>
      <div class="action">
        <p>À vous d'essayer.</p>
        <a href={signup} class="btn">Essai gratuit 7 jours</a>
      </div>
    </div>
  </section>
)}

<style>
  .testimonials { padding-block: var(--space-section); background: var(--paper); }
  h2 { max-width: 16em; margin-bottom: var(--space-heading); }
  /* Cartes de même taille, quelle que soit la longueur des citations. Le nom reste aligné en bas. */
  .wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 16px; margin-inline: auto; }
  .cols-1 { grid-template-columns: minmax(0, 1fr); max-width: 640px; }
  .cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 860px; }
  .item { display: flex; flex-direction: column; padding: 28px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  blockquote { font-size: 1.125rem; line-height: 1.5; color: var(--ink); }
  blockquote { margin-bottom: 20px; }
  figcaption { display: flex; align-items: center; gap: 12px; margin-top: auto; font-size: .9375rem; line-height: 1.4; color: var(--ink-2); }
  figcaption strong { color: var(--navy); font-weight: 600; }
  figcaption img, .slot-photo { flex: none; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .slot-photo { border: 1.5px dashed var(--line-dashed); }
  .action { margin-top: var(--space-after); text-align: center; }
  .action p { margin-bottom: 20px; font-family: var(--title); font-size: clamp(1.375rem, 2vw, 1.625rem); font-weight: 400; letter-spacing: var(--title-track); line-height: 1.25; color: var(--navy); }
  .slot { border: 1.5px dashed var(--line-dashed); background: transparent; }
  .tag { display: block; margin-bottom: 12px; font-size: .875rem; font-weight: 600; color: var(--gold-ink); }

  @media (max-width: 960px) { .cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    /* Sur une seule colonne, chaque carte garde la hauteur de son texte. */
    .wall { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
    .item { padding: 22px; }
    .action .btn { width: 100%; }
  }
</style>
