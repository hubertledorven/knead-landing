---
const signup = 'https://app.kneadmanager.com/#signup';
const check = 'M20 6L9 17l-5-5';
const formules = [
  {
    nom: 'Solo',
    etiquette: 'Populaire',
    prix: '49',
    annuel: 'ou 470 €/an, soit −20 %',
    pointsForts: ['1 utilisateur', '15 scans IA par mois (factures et recettes)', 'Recettes, coûts et marges', 'Import des commandes Shopify en un clic', 'Support par email'],
    cta: 'Essai gratuit 7 jours',
    href: signup,
    note: "Aucune carte bancaire pour l'essai de 7 jours.",
    vedette: true,
  },
  {
    nom: 'Équipe',
    prix: '89',
    annuel: 'ou 854 €/an, soit −20 %',
    offre: "Offre de lancement : 1 mois offert",
    pointsForts: ['Toutes les fonctionnalités Solo', '20 scans IA par jour (factures et recettes)', 'Comptes pour votre équipe', 'Support prioritaire'],
    cta: 'Commencer, 1 mois offert',
    href: signup,
    note: 'Carte bancaire demandée à la souscription. Aucun débit avant 30 jours, annulation en un clic.',
  },
  {
    nom: 'Multi-boutiques',
    annuel: 'Réseaux et franchises',
    pointsForts: ['Toutes les fonctionnalités Équipe', 'Utilisateurs illimités', 'Boutiques illimitées', 'Accompagnement dédié'],
    cta: 'Demander un devis',
    href: 'mailto:contact@kneadmanager.com',
  },
];
---
<section class="pricing" id="tarifs">
  <div class="wrap">
    <h2>Commencez seul, ajoutez votre équipe quand vous voulez</h2>

    <div class="grid">
      {formules.map((f) => (
        <article class:list={['plan', { featured: f.vedette }]}>
          {f.etiquette && <p class="tag">{f.etiquette}</p>}
          <div class="head">
            <h3>{f.nom}</h3>
            {f.prix
              ? <p class="price">{f.prix}&nbsp;€<small>/mois</small></p>
              : <p class="price quote">Sur devis</p>}
            <p class="year">{f.annuel}</p>
            {f.offre && <p class="offer">{f.offre}</p>}
          </div>
          <ul>
            {f.pointsForts.map((p) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>
                {p}
              </li>
            ))}
          </ul>
          <div class="foot">
            <a href={f.href} class:list={['btn', { 'btn-gold': f.vedette, 'btn-line': !f.vedette }]}>{f.cta}</a>
            {f.note && <p class="note">{f.note}</p>}
          </div>
        </article>
      ))}
    </div>
    <p class="after">Annulation à tout moment. Base de données hébergée à Paris.</p>
  </div>
</section>

<style>
  .pricing { padding-block: var(--space-section); }
  h2 { max-width: 17em; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; margin-top: var(--space-heading); }

  /* Sous-grille : listes et boutons s'alignent d'une carte à l'autre. */
  .plan { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; padding: 32px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .price { margin-top: 16px; font-family: var(--title); font-size: 3.25rem; font-weight: var(--title-weight); letter-spacing: var(--title-track); line-height: 1.05; color: var(--navy); }
  .price small { font-family: var(--sans); font-size: 1.0625rem; font-weight: 400; letter-spacing: 0; color: var(--ink-2); }
  .quote { font-size: 2.5rem; line-height: 1.3; }
  .year { margin-top: 6px; font-size: 1rem; color: var(--ink-2); }
  .offer { margin-top: 12px; font-size: 1rem; font-weight: 600; color: var(--gold-ink); }
  .head { padding-bottom: 24px; }
  ul { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; padding-top: 24px; border-top: 1px solid var(--line); }
  li { display: flex; gap: 10px; align-items: flex-start; font-size: 1rem; line-height: 1.4; }
  svg { flex: none; width: 18px; height: 18px; margin-top: 2px; fill: none; stroke: var(--gold-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .foot { display: contents; }
  .btn { min-height: 60px; }
  /* Sans ombre : le bouton doré de la formule mise en avant reste le plus visible. */
  .btn-line { --btn-shadow: none; --btn-shadow-hover: none; background: #fff; color: var(--navy); border: 1px solid var(--navy); }
  .btn-line:hover { background: var(--paper); }
  .note { margin-top: 12px; font-size: .9375rem; line-height: 1.4; color: var(--ink-2); }

  /* Carte Solo : en-tête en dégradé, corps blanc. */
  .plan.featured {
    position: relative; margin-block: -16px; padding: 0; border-color: var(--navy);
    box-shadow: 0 18px 44px rgba(15, 31, 61, .18);
  }
  .featured .head { padding: 48px 32px 24px; background: var(--gradient-navy); border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0 0; color: #fff; }
  /* Étiquette à cheval sur le haut de la carte : elle dit pourquoi Solo est mise en avant. */
  .tag {
    display: none; position: absolute; z-index: 1; top: -15px; left: 50%; transform: translateX(-50%); padding: 5px 14px;
    background: linear-gradient(to bottom, #EAD48F, #D6B75F); border-radius: 999px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .4) inset, 0 6px 16px rgba(160, 128, 40, .3);
    font-size: .875rem; font-weight: 600; color: var(--navy); white-space: nowrap;
  }
  /* Masquée par défaut tant que le client n'a pas confirmé que Solo est la plus souscrite. */
  :global(html[data-tag="populaire"]) .tag { display: block; }
  .featured h3, .featured .price { color: #fff; }
  .featured .price small, .featured .year { color: var(--on-navy-2); }
  .featured ul { margin-inline: 32px; border-top: 0; }
  .featured .btn { margin-inline: 32px; }
  .featured .note { margin: 12px 32px 48px; }

  /* Bouton de Solo : même traitement que celui du hero, en doré. */
  .btn-gold {
    --btn-shadow: 0 0 0 1px rgba(201, 168, 76, .5), 0 10px 30px rgba(201, 168, 76, .45);
    --btn-shadow-hover: 0 0 0 1px rgba(201, 168, 76, .7), 0 14px 38px rgba(201, 168, 76, .6);
    min-height: 60px; padding-inline: 20px; font-size: 1.1875rem;
    background: var(--gradient-gold);
  }
  .btn-gold:hover { background: var(--gradient-gold-hover); }

  .after { margin-top: var(--space-after); font-size: 1rem; text-align: center; color: var(--ink-2); }

  /* Trois cartes étroites sur tablette en paysage : boutons resserrés et sans flèche, pour rester sur une ligne. */
  @media (min-width: 961px) and (max-width: 1180px) {
    .plan { padding: 24px; }
    .plan.featured { padding: 0; }
    .featured .head { padding-inline: 24px; }
    .featured ul, .featured .btn { margin-inline: 24px; }
    .featured .note { margin-inline: 24px; }
    .btn { padding-inline: 12px; }
    .btn::after { display: none; }
  }

  @media (max-width: 960px) {
    .grid { grid-template-columns: minmax(0, 1fr); max-width: 520px; margin-inline: auto; }
    .plan { display: flex; flex-direction: column; }
    .plan.featured { margin-block: 0; }
    .featured .head { padding-top: 32px; }
    .featured .note { margin-bottom: 32px; }
  }
  @media (max-width: 560px) {
    .plan { padding: 24px; }
    .featured .head { padding: 28px 24px 24px; }
    .featured ul { margin-inline: 24px; }
    .featured .btn { margin-inline: 24px; }
    .featured .note { margin: 12px 24px 28px; }
  }
  /* Petits téléphones : même resserrement, pour garder les boutons sur une ligne. */
  @media (max-width: 25em) {
    .btn { padding-inline: 8px; font-size: 1rem; }
    .btn::after { display: none; }
    .btn-gold { font-size: 1.0625rem; }
  }
</style>
