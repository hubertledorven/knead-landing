---
const signup = 'https://app.kneadmanager.com/#signup';
const check = 'M20 6L9 17l-5-5';
const formules = [
  {
    nom: 'Solo',
    prix: '49',
    annuel: 'ou 470 €/an, soit −20 %',
    pointsForts: ['1 utilisateur', '15 scans IA par mois (factures et recettes)', 'Recettes, coûts et marges', 'Import des commandes Shopify en un clic', 'Support par email'],
    cta: 'Essayer gratuitement 7 jours',
    href: signup,
    note: "Aucune carte bancaire pour l'essai de 7 jours.",
    vedette: true,
  },
  {
    nom: 'Équipe',
    prix: '89',
    annuel: 'ou 854 €/an, soit −20 %',
    offre: "Offre de lancement : 1 mois offert",
    pointsForts: ['Toutes les fonctionnalités Solo', '20 scans IA par jour (factures et recettes)', 'Comptes pour votre équipe', 'Support prioritaire'],
    cta: 'Commencer, 1 mois offert',
    href: signup,
    note: 'Carte bancaire demandée à la souscription. Aucun débit avant 30 jours, annulation en un clic.',
  },
  {
    nom: 'Multi-boutiques',
    annuel: 'Réseaux et franchises',
    pointsForts: ['Toutes les fonctionnalités Équipe', 'Utilisateurs illimités', 'Boutiques illimitées', 'Accompagnement dédié'],
    cta: 'Demander un devis',
    href: 'mailto:contact@kneadmanager.com',
  },
];
---
<section class="pricing" id="tarifs">
  <div class="wrap">
    <h2>Commencez seul, ajoutez votre équipe quand vous voulez</h2>
    <p class="intro">Vous ne payez que si vous décidez de continuer.</p>

    <div class="grid">
      {formules.map((f) => (
        <article class:list={['plan', { featured: f.vedette }]}>
          <h3>{f.nom}</h3>
          {f.prix
            ? <p class="price">{f.prix}&nbsp;€<small>/mois</small></p>
            : <p class="price quote">Sur devis</p>}
          <p class="year">{f.annuel}</p>
          {f.offre && <p class="offer">{f.offre}</p>}
          <ul>
            {f.pointsForts.map((p) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>
                {p}
              </li>
            ))}
          </ul>
          <div class="foot">
            <a href={f.href} class:list={['btn', { 'btn-gold': f.vedette, 'btn-line': !f.vedette }]}>{f.cta}</a>
            {f.note && <p class="note">{f.note}</p>}
          </div>
        </article>
      ))}
    </div>
    <p class="after">Annulation à tout moment. Base de données hébergée à Paris.</p>
  </div>
</section>

<style>
  .pricing { padding-block: 104px; }
  h2 { max-width: 17em; }
  .intro { margin-top: 16px; font-size: 1.25rem; color: var(--ink-2); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; margin-top: 64px; }

  .plan { display: flex; flex-direction: column; padding: 32px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .price { margin-top: 16px; font-family: var(--title); font-size: 3.25rem; font-weight: var(--title-weight); letter-spacing: var(--title-track); line-height: 1.05; color: var(--navy); }
  .price small { font-family: var(--sans); font-size: 1.0625rem; font-weight: 400; letter-spacing: 0; color: var(--ink-2); }
  .quote { font-size: 2.5rem; line-height: 1.3; }
  .year { margin-top: 6px; font-size: 1rem; color: var(--ink-2); }
  .offer { margin-top: 12px; font-size: 1rem; font-weight: 600; color: var(--gold-ink); }
  ul { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-block: 24px 28px; padding-top: 24px; border-top: 1px solid var(--line); }
  li { display: flex; gap: 10px; align-items: flex-start; font-size: 1rem; line-height: 1.4; }
  svg { flex: none; width: 18px; height: 18px; margin-top: 2px; fill: none; stroke: var(--gold-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .foot { margin-top: auto; }
  .btn { width: 100%; }
  .btn-line { background: #fff; color: var(--navy); border: 1px solid var(--navy); }
  .btn-line:hover { background: var(--paper); }
  .note { margin-top: 12px; font-size: .9375rem; line-height: 1.4; color: var(--ink-2); }

  .featured { margin-block: -16px; padding-block: 48px; background: var(--navy); border-color: var(--navy); color: #fff; }
  .featured h3, .featured .price { color: #fff; }
  .featured .price small, .featured .year, .featured .note { color: var(--on-navy-2); }
  .featured ul { border-top-color: rgba(255, 255, 255, .16); }
  .featured svg { stroke: var(--gold); }

  .after { margin-top: 32px; font-size: 1rem; color: var(--ink-2); }

  @media (max-width: 960px) {
    .grid { grid-template-columns: minmax(0, 1fr); max-width: 520px; }
    .featured { margin-block: 0; padding-block: 32px; }
  }
  @media (max-width: 560px) {
    .pricing { padding-block: 64px; }
    .intro { font-size: 1.125rem; }
    .plan { padding: 24px; }
  }
</style>
