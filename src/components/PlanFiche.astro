---
// Autre proposition pour les trois étapes : une fiche qui se remplit à gauche pendant que les étapes défilent à droite.
// Chiffres repris de la fiche de l'entremets dans l'app ; le prix ajusté à 38 € est un exemple.
const etapes = [
  { titre: 'Photographiez vos factures', texte: 'Vos ingrédients et vos prix se créent tout seuls. Rien à ressaisir.' },
  { titre: 'Ajoutez vos recettes', texte: 'Scannez-les ou saisissez-les. Knead calcule le coût de chacune, au centime.' },
  { titre: 'Ajustez vos prix', texte: 'Vous voyez ce qui rapporte et ce qui coûte, et vous décidez en connaissance de cause.' },
];
---
<section class="fiche-etapes">
  <div class="wrap">
    <h2 data-reveal>Vos vraies marges en trois étapes</h2>
    <div class="scene">
      <div class="panneau" aria-hidden="true">
        <div class="feuille">
          <p class="titre"><b>Entremets</b><span>Exemple</span></p>
          <div class="blocs">
            <div class="bloc">
              <p class="nom">Facture lue</p>
              <p class="ligne"><span>Beurre de tourage</span><b>9,85&nbsp;€/kg <em>+0,85&nbsp;€</em></b></p>
              <p class="ligne"><span>Crème 35&nbsp;%</span><b>4,35&nbsp;€/L <em>+0,15&nbsp;€</em></b></p>
              <p class="ligne"><span>Chocolat noir 70&nbsp;%</span><b>13,50&nbsp;€/kg</b></p>
            </div>
            <div class="bloc">
              <p class="nom">Coût calculé</p>
              <p class="ligne"><span>Ingrédients</span><b>6,99&nbsp;€</b></p>
              <p class="ligne"><span>Emballage</span><b>2,01&nbsp;€</b></p>
              <p class="ligne"><span>Temps de travail et pertes</span><b>24,48&nbsp;€</b></p>
              <p class="ligne total"><span>Coût total</span><b>33,48&nbsp;€</b></p>
            </div>
            <div class="bloc">
              <p class="nom">Prix ajusté</p>
              <p class="ligne"><span>Prix de vente</span><b class="prix">38,00&nbsp;€</b></p>
              <p class="marge"><span>Marge par pièce</span><b class="valeur">+4,52&nbsp;€</b></p>
            </div>
          </div>
        </div>
      </div>
      <ol>
        <div class="fil" aria-hidden="true"><i class="plein"></i><i class="point"></i></div>
        {etapes.map((e, i) => (
          <li>
            <span class="num" aria-hidden="true">Étape {i + 1}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  // Les étapes défilent à droite ; la fiche se remplit à leur passage et le prix s'ajuste au rythme du défilement.
  (function () {
    var section = document.querySelector('.fiche-etapes');
    if (!section || !document.documentElement.classList.contains('anime')) return;
    var etapes = [].slice.call(section.querySelectorAll('ol > li'));
    var blocs = [].slice.call(section.querySelectorAll('.bloc'));
    var fil = section.querySelector('.fil'), plein = fil.querySelector('.plein'), point = fil.querySelector('.point');
    var prix = section.querySelector('.prix'), valeur = section.querySelector('.valeur'), marge = section.querySelector('.marge');
    var attente = false, COUT = 33.48;

    function euros(v) { return Math.abs(v).toFixed(2).replace('.', ',') + ' €'; }
    function centre(el) { var r = el.getBoundingClientRect(); return r.top + r.height / 2; }

    function dessiner() {
      attente = false;
      var repere = innerHeight * .62, courant = -1;
      var centres = etapes.map(centre);
      etapes.forEach(function (e, i) {
        var atteinte = centres[i] <= repere;
        if (atteinte) courant = i;
        e.classList.toggle('atteinte', atteinte);
        blocs[i].classList.toggle('atteinte', atteinte);
      });
      blocs.forEach(function (b, i) { b.classList.toggle('courant', i === Math.max(courant, 0)); });

      // Le fil s'arrête au centre de la dernière étape.
      var haut = fil.getBoundingClientRect().top, hauteur = fil.offsetHeight;
      var y = Math.max(0, Math.min(repere - haut, hauteur));
      plein.style.transform = 'scaleY(' + (hauteur ? y / hauteur : 0) + ')';
      point.style.transform = 'translate(-50%, ' + y + 'px)';

      // De 30 € à 38 € pendant que la dernière étape remonte.
      var t = Math.max(0, Math.min(1, (repere - centres[2]) / (innerHeight * .14)));
      var p = 30 + 8 * t, m = p - COUT;
      prix.textContent = euros(p);
      valeur.textContent = (m < 0 ? '−' : '+') + euros(m);
      marge.classList.toggle('negative', m < 0);
    }
    function demander() { if (!attente) { attente = true; requestAnimationFrame(dessiner); } }
    function mesurer() {
      var r = fil.parentElement.getBoundingClientRect();
      fil.style.top = (centre(etapes[0]) - r.top) + 'px';
      fil.style.height = (centre(etapes[2]) - centre(etapes[0])) + 'px';
      demander();
    }
    section.classList.add('pilote');
    mesurer();
    addEventListener('scroll', demander, { passive: true });
    // Hauteurs recalculées au changement de largeur, et quand le sélecteur de la maquette affiche la section.
    if ('ResizeObserver' in window) new ResizeObserver(mesurer).observe(section);
    else addEventListener('resize', mesurer);
  })();
</script>

<style>
  .fiche-etapes { padding-block: var(--space-section); background: #fff; }
  /* Choix du sélecteur de la maquette : la version avec la ligne prend alors sa place. */
  :global(html[data-etapes="captures"]) .fiche-etapes { display: none; }

  .scene { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 88px); align-items: start; margin-top: var(--space-heading); }

  /* La fiche reste centrée à l'écran pendant que les étapes défilent à côté. */
  .panneau {
    position: sticky; top: max(calc(var(--header-h) + 16px), calc(var(--header-h) + (100svh - var(--header-h)) / 2 - 262px)); padding: 28px;
    background: var(--gradient-navy); border-radius: var(--radius-lg);
    box-shadow: 0 24px 56px rgba(15, 31, 61, .24);
  }
  .feuille { padding: 20px 24px 24px; background: #fff; border-radius: 12px; box-shadow: 0 14px 32px rgba(0, 0, 0, .3); font-size: .9375rem; line-height: 1.35; font-variant-numeric: tabular-nums; }
  .titre { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .titre b { font-family: var(--title); font-size: 1.25rem; font-weight: var(--title-weight); color: var(--navy); }
  .titre span { font-size: .875rem; }
  .blocs { display: grid; gap: 16px; padding-top: 16px; }
  .nom { margin-bottom: 4px; font-size: .8125rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--gold-ink); }
  .ligne { display: flex; justify-content: space-between; gap: 12px; padding-block: 4px; color: var(--ink-2); }
  .ligne b { font-weight: 600; color: var(--navy); white-space: nowrap; }
  .ligne em { margin-left: 6px; font-style: normal; color: var(--loss); }
  .total { margin-top: 4px; padding-top: 8px; border-top: 1px solid var(--line); color: var(--navy); font-weight: 600; }
  .marge { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 4px; padding-top: 8px; border-top: 1px solid var(--line); color: var(--navy); font-weight: 600; }
  .valeur { font-family: var(--title); font-size: clamp(1.75rem, 2.8vw, 2.25rem); font-weight: var(--title-weight); letter-spacing: var(--title-track); line-height: 1.1; color: var(--ok); transition: color .25s ease; }
  .negative .valeur { color: var(--loss); }

  ol { position: relative; list-style: none; }
  li { display: flex; flex-direction: column; justify-content: center; min-height: 62svh; padding-left: 40px; }
  .num { font-size: .9375rem; font-weight: 600; color: var(--gold-ink); }
  h3 { margin-top: 10px; font-size: clamp(1.75rem, 2.8vw, 2.5rem); }
  li p { margin-top: 14px; color: var(--ink-2); }

  /* Fil et point à côté des étapes, placés par le script. */
  .fil { display: none; position: absolute; left: 7px; width: 2px; background: var(--line-strong); }
  .plein { position: absolute; inset: 0; background: var(--gold); transform-origin: 50% 0; }
  .point { position: absolute; top: -8px; left: 50%; width: 16px; height: 16px; background: var(--navy); border-radius: 50%; box-shadow: 0 0 0 5px rgba(201, 168, 76, .4); transform: translateX(-50%); }

  /* Suivi au défilement : sans JavaScript ou avec les animations réduites, la fiche et les étapes restent complètes. */
  .pilote .fil { display: block; }
  .pilote li { opacity: .3; translate: 0 16px; transition: opacity .5s ease, translate .7s cubic-bezier(.16, 1, .3, 1); }
  .pilote li.atteinte { opacity: 1; translate: none; }
  .pilote .bloc { opacity: 0; translate: 0 14px; transition: opacity .45s ease, translate .6s cubic-bezier(.16, 1, .3, 1); }
  .pilote .bloc.atteinte { opacity: 1; translate: none; }
  @media print {
    .pilote li, .pilote .bloc { opacity: 1; translate: none; }
    .fil { display: none !important; }
  }

  /* Sur une colonne : la fiche reste en haut et n'affiche que l'étape en cours. */
  @media (max-width: 860px) {
    .scene { display: block; }
    .panneau { top: calc(var(--header-h) + 8px); z-index: 1; padding: 12px; }
    .feuille { padding: 14px 16px 16px; }
    .titre { padding-bottom: 8px; }
    .blocs { padding-top: 10px; }
    .pilote .blocs > .bloc { grid-area: 1 / 1; opacity: 0; translate: 0 10px; }
    .pilote .blocs > .bloc.courant { opacity: 1; translate: none; }
    li { min-height: 46svh; padding-left: 32px; }
  }
</style>
