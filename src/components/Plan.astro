---
import { Image } from 'astro:assets';
import facture from '../assets/etape-facture-recadree.png';
import recette from '../assets/etape-recette-recadree.png';
import prix from '../assets/etape-prix.png';

const etapes = [
  { titre: 'Photographiez vos factures', texte: 'Vos ingrédients et vos prix se créent tout seuls. Rien à ressaisir.', image: facture, telephone: true, alt: "Knead sur téléphone : le bouton Photographier pour scanner une facture fournisseur." },
  { titre: 'Ajoutez vos recettes', texte: 'Scannez-les ou saisissez-les. Knead calcule le coût de chacune, au centime.', image: recette, etroit: true, alt: "Ingrédients d'une recette dans Knead, chacun avec sa quantité en grammes." },
  { titre: 'Ajustez vos prix', texte: 'Vous voyez ce qui rapporte et ce qui coûte, et vous décidez en connaissance de cause.', image: prix, alt: "Analyse recette par recette dans Knead : l'entremets perd 3,48 € par pièce, soit −12 % de marge ; le flan, la tarte citron et le saint-honoré sont à plus de 50 % de marge." },
];
---
<section class="plan">
  <div class="wrap">
    <h2 data-reveal>Vos vraies marges en trois étapes</h2>
    <ol>
      <div class="rail" aria-hidden="true"><i class="plein"></i><i class="point"></i></div>
      {etapes.map((e, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <div class="step">
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </div>
          <div class:list={['visuel', { telephone: e.telephone, etroit: e.etroit }]}>
            <Image src={e.image} alt={e.alt} widths={e.telephone ? [260, 520] : e.etroit ? [420, 750] : [620, 1028]} sizes={e.telephone ? '260px' : e.etroit ? '420px' : '(max-width: 860px) 90vw, 620px'} format="webp" quality={90} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script is:inline>
  // La ligne se remplit au défilement et son point la suit ; chaque étape s'éclaire quand il l'atteint, et s'éteint si l'on remonte.
  (function () {
    var liste = document.querySelector('.plan ol');
    if (!liste || !document.documentElement.classList.contains('anime')) return;
    var rail = liste.querySelector('.rail'), plein = rail.querySelector('.plein'), point = rail.querySelector('.point');
    var lignes = [].slice.call(liste.querySelectorAll('li')), attente = false;

    function centre(el) { var r = el.getBoundingClientRect(); return r.top + r.height / 2; }

    function dessiner() {
      attente = false;
      var depart = rail.getBoundingClientRect().top;
      var hauteur = rail.offsetHeight;
      var repere = innerHeight * .62;
      var y = Math.max(0, Math.min(repere - depart, hauteur));
      plein.style.transform = 'scaleY(' + (hauteur ? y / hauteur : 0) + ')';
      point.style.transform = 'translate(-50%, ' + y + 'px)';
      lignes.forEach(function (l) {
        l.classList.toggle('atteinte', centre(l.querySelector('.num')) <= depart + y + 1);
      });
    }
    function demander() { if (!attente) { attente = true; requestAnimationFrame(dessiner); } }

    // La ligne s'arrête au centre de la dernière pastille, quelle que soit la hauteur des rangées.
    function mesurer() {
      var nums = liste.querySelectorAll('.num');
      rail.style.bottom = 'auto';
      rail.style.height = (centre(nums[nums.length - 1]) - centre(nums[0])) + 'px';
      demander();
    }
    liste.classList.add('suivi');
    mesurer();
    addEventListener('scroll', demander, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(mesurer).observe(liste);
    else addEventListener('resize', mesurer);
  })();
</script>

<style>
  .plan { padding-block: var(--space-section); background: var(--gradient-navy); color: #fff; }
  /* Affichée seulement si le sélecteur de la maquette la demande : la fiche est proposée par défaut. */
  :global(html:not([data-etapes="captures"])) .plan { display: none; }
  h2 { color: #fff; }

  /* Une rangée par étape : pastille sur la ligne, texte, puis capture. */
  ol { --num: 44px; position: relative; list-style: none; display: grid; gap: clamp(72px, 12vh, 128px); margin-top: var(--space-heading); }
  li { position: relative; display: grid; grid-template-columns: var(--num) minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); align-items: start; }

  /* Rangées de même hauteur : la ligne avance au même rythme d'une étape à l'autre. */
  @media (min-width: 861px) {
    li { min-height: 300px; }
  }

  .rail { position: absolute; top: calc(var(--num) / 2); bottom: 0; left: calc(var(--num) / 2 - 1px); width: 2px; background: rgba(255, 255, 255, .18); }
  .plein { position: absolute; inset: 0; background: var(--gold); transform-origin: 50% 0; }
  .point { display: none; position: absolute; top: -8px; left: 50%; width: 16px; height: 16px; background: #fff; border-radius: 50%; box-shadow: 0 0 0 5px rgba(201, 168, 76, .35), 0 0 22px 4px rgba(201, 168, 76, .55); transform: translateX(-50%); }
  :global(.suivi) .point { display: block; }

  .num {
    position: relative; z-index: 1; display: grid; place-items: center; width: var(--num); height: var(--num);
    background: var(--gold); border-radius: 50%;
    font-family: var(--title); font-size: 1.25rem; font-weight: var(--title-weight); line-height: 1; color: var(--navy);
  }
  h3 { font-size: clamp(1.75rem, 2.8vw, 2.5rem); color: #fff; }
  .step p { margin-top: 16px; color: var(--on-navy-2); }
  .visuel { border-radius: 14px; box-shadow: 0 20px 48px rgba(0, 0, 0, .35); }
  .visuel img { width: 100%; border-radius: inherit; }
  /* Capture en hauteur : moins large que la colonne, pour ne pas allonger la rangée. */
  .etroit { justify-self: center; width: min(420px, 100%); }
  /* Capture de téléphone : entière, dans son cadre. */
  .telephone { justify-self: center; width: min(260px, 100%); padding: 6px; background: var(--navy-deep); border-radius: 28px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .14), 0 20px 48px rgba(0, 0, 0, .35); }
  .telephone img { border-radius: 22px; }

  /* Suivi au défilement : sans JavaScript ou avec les animations réduites, tout reste affiché et la ligne pleine. */
  :global(.suivi) li :is(.step, .visuel) { opacity: .25; translate: 0 18px; transition: opacity .5s ease, translate .7s cubic-bezier(.16, 1, .3, 1); }
  :global(.suivi) li.atteinte :is(.step, .visuel) { opacity: 1; translate: none; }
  :global(.suivi) li .num { background: var(--navy-soft); box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .28); color: rgba(255, 255, 255, .6); transition: background-color .3s ease, color .3s ease, box-shadow .3s ease, scale .4s cubic-bezier(.34, 1.56, .64, 1); }
  :global(.suivi) li.atteinte .num { background: var(--gold); box-shadow: none; color: var(--navy); scale: 1.08; }
  @media print {
    :global(.suivi) li :is(.step, .visuel) { opacity: 1; translate: none; }
    .point { display: none; }
  }

  /* Sur une colonne : la ligne reste à gauche, le texte puis la capture à côté d'elle. */
  @media (max-width: 860px) {
    ol { --num: 36px; gap: 56px; }
    li { grid-template-columns: var(--num) minmax(0, 1fr); gap: 20px 16px; }
    .visuel { grid-column: 2; }
    .telephone { justify-self: start; width: min(220px, 100%); }
    .num { font-size: 1.0625rem; }
  }
</style>
