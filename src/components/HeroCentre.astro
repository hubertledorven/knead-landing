---
import { Image } from 'astro:assets';
import capture from '../assets/hero-dashboard.png';

const signup = 'https://app.kneadmanager.com/#signup';
---
<section class="hero">
  <div class="wrap copy">
    <h1>Sachez enfin ce que chaque gâteau vous rapporte.</h1>
    <p class="lead">Photographiez vos factures&nbsp;: Knead met vos prix d'achat à jour et recalcule la marge de chaque recette.</p>
    <a href={signup} class="btn">Essayer gratuitement 7 jours</a>
    <p class="note">Sans carte bancaire. Sans installation.</p>
  </div>

  <div class="band">
    <div class="wrap">
      <div class="stage">
      <div class="shot">
        <Image
          src={capture}
          alt="Tableau de bord Knead : production du jour, commandes à venir et stocks à commander"
          widths={[640, 960, 1152, 1600, 2304]}
          sizes="(max-width: 1200px) 100vw, 1152px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <!-- Exemples illustratifs, à aligner sur l'app réelle. -->
      <div class="float float-a" aria-hidden="true">
        <span>Facture lue</span>
        <p><b>Beurre de tourage</b><em>+7&nbsp;%</em></p>
      </div>
      <div class="float float-b" aria-hidden="true">
        <span>Marge recalculée</span>
        <p><b>Entremets</b><em>−3,45&nbsp;€</em></p>
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  .copy { display: flex; flex-direction: column; align-items: center; padding-block: 56px 56px; text-align: center; }
  h1 { max-width: 15em; }
  .lead { margin-top: 24px; font-size: 1.25rem; line-height: 1.5; color: var(--ink-2); max-width: 36em; }
  .btn { margin-top: 32px; }
  .note { margin-top: 14px; font-size: 1rem; color: var(--ink-2); }

  /* Le bloc navy démarre à mi-hauteur de la capture, coupée en bas. */
  .band { overflow: hidden; background: linear-gradient(to bottom, #fff 0, #fff 96px, var(--navy) 96px); }
  .shot {
    height: 560px; overflow: hidden;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 0 0 1px var(--line), 0 24px 60px rgba(15, 31, 61, .25);
  }
  .shot img { width: 100%; }

  .stage { position: relative; }
  .float {
    position: absolute; width: 270px; padding: 16px 18px;
    background: #fff; border: 1px solid var(--line); border-radius: 10px;
    box-shadow: 0 16px 40px rgba(15, 31, 61, .28);
    font-variant-numeric: tabular-nums;
  }
  .float span { display: block; font-size: .875rem; color: var(--ink-2); }
  .float p { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 6px; }
  .float b { font-weight: 600; color: var(--navy); }
  .float em { flex: none; font-style: normal; font-weight: 600; color: var(--loss); }
  .float-a { top: 208px; left: 12px; }
  .float-b { top: 356px; right: 12px; }

  @media (max-width: 760px) {
    .copy { padding-block: 32px 40px; }
    .lead { font-size: 1.125rem; }
    .btn { width: 100%; }
    .band { background: linear-gradient(to bottom, #fff 0, #fff 56px, var(--navy) 56px); }
    .shot { height: 260px; }
    .shot img { width: 720px; max-width: none; }
    .float { width: min(230px, 66%); padding: 10px 12px; }
    .float span { font-size: .8125rem; }
    .float p { margin-top: 3px; font-size: .9375rem; }
    .float-a { top: 72px; left: 8px; }
    .float-b { top: auto; bottom: 16px; right: 8px; }
  }
</style>
